NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/alvince.sqlite
UPLOAD_DIR=./data/uploads
# Set this to true only when your production host terminates HTTPS in front of Node.
COOKIE_SECURE=false
# Used by the admin bootstrap command to make sure a mistyped command cannot create a normal account by accident.
ADMIN_BOOTSTRAP_ENABLED=false


# Optional TURN relay for reliable calls on restrictive mobile or office networks.
# Use a trusted TURN service that supports coturn shared-secret credentials.
# Set the real values privately in Render environment variables; never commit the secret.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=
